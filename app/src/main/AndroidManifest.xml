<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".ZennyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/zennyicon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/zennyicon"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZENNY"
        tools:targetApi="31">
        <activity
            android:name=".activity_home"
            android:exported="true"
            android:theme="@style/Theme.ZENNY">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity_onboard1"
            android:exported="false"
            android:theme="@style/Theme.ZENNY" />
        <activity
            android:name=".activity_onboard2"
            android:exported="false"
            android:theme="@style/Theme.ZENNY" />
        <activity
            android:name=".activity_onboard3"
            android:exported="false"
            android:theme="@style/Theme.ZENNY" />

        <activity
            android:name=".UserProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.ZENNY" />

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.Dialog" />


        <receiver
            android:name=".ReminderBroadcastReceiver"
            android:enabled="true"
            android:exported="false" />


        <service
            android:name=".WaterReminderService"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
